.DS_Store
Icon?
Icon\r
.~*

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Secrets and local runtime data
.env
*.env
config/family_budget.yaml
data/*.sqlite

# Claude Code local files
.claude/

# Local React app runtime files
node_modules/
dist/
.data/
data/family.json
