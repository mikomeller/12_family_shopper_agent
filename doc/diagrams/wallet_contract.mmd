%% Version:   0.3.0
%% Filename:  wallet_contract.mmd
%% Pathname:  doc/diagrams/wallet_contract.mmd
%% Purpose:   Family Wallet MCP contract: data model and the place_order / request_approval / approve_request
%%            decision flow (spec: doc/design/wallet_mcp.md)
flowchart TB
    subgraph DM["Data model (SQLite data/wallet.sqlite, money = integer cents)"]
      direction LR
      FAM["family<br/>id=1 · family_cap_cents"]
      MEM["members<br/>id PK · role parent|teen|child<br/>personal_cap_cents NULL=no cap"]
      REQ["approval_requests<br/>id PK · member_id FK · price_cents<br/>status open|approved|rejected · order_id FK"]
      ORD["orders<br/>id PK · member_id FK · placed_by FK<br/>price_cents · month YYYY-MM · request_id UNIQUE"]
      MEM -->|1..n| ORD
      MEM -->|1..n| REQ
      REQ -.->|0..1 when approved| ORD
    end

    CALL([MCP tool call]) --> RES{"IdentityResolver.resolve()<br/>token from env WALLET_MEMBER_TOKEN"}
    RES -->|no token| E1[/IDENTITY_MISSING/]
    RES -->|bad signature, expired,<br/>unknown member| E2[/IDENTITY_INVALID/]
    RES -->|caller = Member| VAL{"input valid?<br/>price_cents int > 0"}
    VAL -->|no| E3[/INVALID_AMOUNT or INVALID_INPUT/]
    VAL -->|yes| TOOL{tool}

    TOOL -->|place_order| PO{"caller role"}
    PO -->|"parent, teen or child"| TX1

    TOOL -->|request_approval| RA{"caller role = child or teen?"}
    RA -->|no| E4b[/NOT_ALLOWED_FOR_ROLE<br/>use place_order/]
    RA -->|yes| INSREQ["INSERT approval_requests status=open<br/>no order, no spend"]

    TOOL -->|reject_request| RJ{"caller role = parent?"}
    RJ -->|no| E5
    RJ -->|yes| TX4

    TOOL -->|approve_request| AP{"caller role = parent?"}
    AP -->|no| E5[/NOT_A_PARENT/]
    AP -->|yes| TX2

    subgraph TXN["ONE write transaction: BEGIN IMMEDIATE ... COMMIT"]
      TX1["spend = SUM(price_cents) WHERE month = current month<br/>(personal: member_id = caller)"] --> CAP
      TX4["load request: exists? status = open?"] -->|missing| E6
      TX4 -->|not open: approved or rejected| E7
      TX4 -->|open| REJ["UPDATE request status=rejected, decided_by, decided_at<br/>no order, no spend"]
      TX2["load request: exists? status = open?"] -->|missing| E6[/REQUEST_NOT_FOUND/]
      TX2 -->|not open| E7[/REQUEST_NOT_OPEN/]
      TX2 -->|open| TX3["family spend only (a parent approves; counts for the requester and the family)"] --> FCAP
      CAP{"personal_spend + price ≤ personal cap?<br/>family_spend + price ≤ family cap?"}
      CAP -->|personal no| E8[/PERSONAL_CAP_EXCEEDED<br/>teen or child: A parent can step in, use request_approval/]
      CAP -->|family no| E9[/FAMILY_CAP_EXCEEDED<br/>ROLLBACK; a request stays open/]
      FCAP{"family_spend + price ≤ family cap?"}
      FCAP -->|no| E9
      FCAP -->|yes| INS
      CAP -->|both yes| INS["INSERT orders; if approval: UPDATE request status=approved"]
    end
    REJ --> OKR([ok: request_id, status=rejected, member_id,<br/>product_name, price_cents, rejected_by])
    INS --> OK([ok: order_id, price, shop, deep_link,<br/>remaining_personal_cents, remaining_family_cents])
